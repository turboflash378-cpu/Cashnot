# Load .env if present
load_dotenv()

# Configuration
TOKEN = os.getenv("TOKEN")
DB_PATH = os.getenv("DATABASE", "users.db")
LOG_LEVEL = os.getenv("LOG_LEVEL", "INFO").upper()

if not TOKEN:
    raise SystemExit("ERROR: TOKEN is not set in environment variables")

# Logging
logging.basicConfig(
    level=LOG_LEVEL,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[logging.StreamHandler(sys.stdout)]
)
logger = logging.getLogger("cashnot-bot")

# Bot
bot = telebot.TeleBot(TOKEN, threaded=True)

# Graceful shutdown flag
running = True

def handle_sigterm(signum, frame):
    global running
    logger.info("Received shutdown signal, stopping bot...")
    running = False
    try:
        bot.stop_polling()
    except Exception:
        pass

signal.signal(signal.SIGINT, handle_sigterm)
signal.signal(signal.SIGTERM, handle_sigterm)

# Database helpers
@contextmanager
def get_conn():
    conn = sqlite3.connect(DB_PATH, timeout=10, check_same_thread=False)
    try:
        yield conn
    finally:
        conn.close()

def init_db():
    with get_conn() as conn:
        cur = conn.cursor()
        cur.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                first_name TEXT,
                age_group TEXT,
                ref_code TEXT UNIQUE,
                referrer_id INTEGER,
                registered_at TEXT
            )
        ''')
        cur.execute('CREATE INDEX IF NOT EXISTS idx_referrer ON users(referrer_id)')
        conn.commit()
    logger.info("Database initialized (%s)", DB_PATH)

def generate_ref_code(k=6):
    alphabet = string.ascii_uppercase + string.digits
    return ''.join(random.choices(alphabet, k=k))

def add_user(user_id: int, username: str, first_name: str, age_group: str = "не указан", referrer_id: Optional[int] = None):
    with get_conn() as conn:
        cur = conn.cursor()
        cur.execute('SELECT 1 FROM users WHERE user_id = ?', (user_id,))
        if cur.fetchone():
            return False  # already exists
        # unique ref_code
        for _ in range(10):
            ref_code = generate_ref_code()
            cur.execute('SELECT 1 FROM users WHERE ref_code = ?', (ref_code,))
            if not cur.fetchone():
                break
        else:
            # fallback: use timestamp
            ref_code = f"R{int(time.time())}"
        cur.execute('''
            INSERT INTO users (user_id, username, first_name, age_group, ref_code, referrer_id, registered_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        ''', (user_id, username, first_name, age_group, ref_code, referrer_id, datetime.utcnow().isoformat()))
        conn.commit()
    logger.info("New user added: %s (referrer=%s)", user_id, referrer_id)
    return True

def user_exists(user_id: int) -> bool:
    with get_conn() as conn:
        cur = conn.cursor()
        cur.execute('SELECT 1 FROM users WHERE user_id = ?', (user_id,))
        return cur.fetchone() is not None

def get_user_by_ref(ref_code: str) -> Optional[int]:
    with get_conn() as conn:
        cur = conn.cursor()
        cur.execute('SELECT user_id FROM users WHERE ref_code = ?', (ref_code,))
        r = cur.fetchone()
        return r[0] if r else None

def get_user_ref_code(user_id: int) -> Optional[str]:
    with get_conn() as conn:
        cur = conn.cursor()
        cur.execute('SELECT ref_code FROM users WHERE user_id = ?', (user_id,))
        r = cur.fetchone()
        return r[0] if r else None

def get_user_referrals(user_id: int) -> int:
    with get_conn() as conn:
        cur = conn.cursor()
        cur.execute('SELECT COUNT(*) FROM users WHERE referrer_id = ?', (user_id,))
        return cur.fetchone()[0]

def set_age_group(user_id: int, age_group: str):
    with get_conn() as conn:
        cur = conn.cursor()
        cur.execute('UPDATE users SET age_group = ? WHERE user_id = ?', (age_group, user_id))
        conn.commit()

